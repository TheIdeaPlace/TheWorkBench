<Window x:Class="TheCardPlace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Card Place"
        Icon="Assets/TheCardPlace.ico"
        Width="1180" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}">
    <DockPanel>
        <!-- Reached with Alt or F10, as in other Windows apps, never with Tab. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="None" IsTabStop="False" FontSize="14" />

        <!-- A real status bar, so JAWS Insert+Page Down and NVDA Insert+End read it. Never live:
             the announcer has already spoken whatever it shows. Ctrl+F9 reads it again,
             Ctrl+Shift+F9 moves into it and Escape comes back. -->
        <StatusBar DockPanel.Dock="Bottom" KeyboardNavigation.TabNavigation="None" Background="{DynamicResource Brush.Panel}">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBox x:Name="StatusText" IsReadOnly="True" IsTabStop="False" BorderThickness="0" FontSize="13"
                         Background="Transparent" Foreground="{DynamicResource Brush.Text}"
                         AutomationProperties.Name="Last message" TextWrapping="NoWrap"
                         PreviewKeyDown="StatusText_PreviewKeyDown" />
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="Pages" />
    </DockPanel>
</Window>
