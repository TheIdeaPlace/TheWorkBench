<Window x:Class="TheCardPlace.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="20,14,20,16">
        <Label Content="Your _name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,2" FontSize="14" />
        <TextBox x:Name="NameBox" FontSize="15" Padding="4" MaxLength="24" AutomationProperties.Name="Your name" />

        <GroupBox Header="Playing" Margin="0,14,0,0" Padding="8,6" FontSize="14">
            <StackPanel>
                <CheckBox x:Name="MoveFocusBox" Content="_Move to my cards when it is my turn" />
                <CheckBox x:Name="EveryPlayBox" Content="Speak _each computer play as it happens" />
                <TextBlock TextWrapping="Wrap" Margin="22,0,0,4" FontSize="13" Foreground="{DynamicResource Brush.TextSoft}"
                           Text="Off, a run of plays is spoken together once it ends. At the Immediate pace they are always spoken together." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Screen Reader Announcements" Margin="0,12,0,0" Padding="8,6" FontSize="14">
            <StackPanel>
                <CheckBox x:Name="SpeakBox" Content="_Speak announcements" Click="SpeakBox_Click" />
                <StackPanel x:Name="CategoryPanel" Margin="22,2,0,0" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,2" FontSize="13" Foreground="{DynamicResource Brush.TextSoft}"
                           Text="Refusals, and anything you ask to hear with the review keys, are always spoken. Everything still goes into the game log and the status bar." />
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="90" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,0,8" />
        </StackPanel>
    </StackPanel>
</Window>
