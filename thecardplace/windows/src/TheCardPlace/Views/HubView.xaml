<UserControl x:Class="TheCardPlace.App.Views.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource Brush.FeltTable}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="1.3*" />
        </Grid.ColumnDefinitions>

        <!-- The games. One Tab stop; arrows move between games; Enter plays. -->
        <DockPanel Grid.Column="0" Margin="24,20,12,24">
            <TextBlock DockPanel.Dock="Top" Text="The Card Place" FontSize="30" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.OnFelt}" />
            <TextBlock DockPanel.Dock="Top" Text="Five card games against the computer, built for the keyboard and the screen reader."
                       FontSize="15" TextWrapping="Wrap" Margin="0,2,0,14" Foreground="{DynamicResource Brush.OnFeltSoft}" />
            <Label DockPanel.Dock="Top" Content="_Choose a game" Target="{Binding ElementName=GamesList}" Style="{StaticResource FeltLabel}" />
            <ListBox x:Name="GamesList" Style="{StaticResource QuietList}" Background="{DynamicResource Brush.Rail}"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Games"
                     SelectionChanged="GamesList_SelectionChanged" KeyDown="GamesList_KeyDown"
                     MouseDoubleClick="GamesList_MouseDoubleClick" GotKeyboardFocus="GamesList_GotKeyboardFocus">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Padding="12,10" Margin="4,3" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="58" CornerRadius="5" Background="{DynamicResource Brush.CardFace}"
                                                    BorderBrush="{DynamicResource Brush.CardEdge}" BorderThickness="1.5" HorizontalAlignment="Left">
                                                <TextBlock x:Name="Pip" Text="{Binding Symbol}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.CardBlack}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Brush.OnFelt}" />
                                                <TextBlock Text="{Binding Players}" FontSize="13" Foreground="{DynamicResource Brush.OnFeltSoft}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRed}" Value="True">
                                            <Setter TargetName="Pip" Property="Foreground" Value="{DynamicResource Brush.CardRed}" />
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Felt}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.OnFeltSoft}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- The selected game: what it is, the player's name, and its options. -->
        <Border Grid.Column="1" Margin="12,20,24,24" CornerRadius="10" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="22,16">
                <StackPanel>
                    <TextBlock x:Name="GameTitle" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock x:Name="GameTagline" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{DynamicResource Brush.Text}" />

                    <Label Content="Your _name" Target="{Binding ElementName=NameBox}" Style="{StaticResource PanelLabel}" />
                    <TextBox x:Name="NameBox" FontSize="15" Padding="4" MaxLength="24" Width="260" HorizontalAlignment="Left"
                             AutomationProperties.Name="Your name" TextChanged="NameBox_TextChanged" />

                    <!-- Options for this game, drawn from its list of rules. -->
                    <StackPanel x:Name="OptionsPanel" Margin="0,6,0,0" />

                    <WrapPanel Margin="0,20,0,0">
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Click="PlayButton_Click" />
                        <Button x:Name="RulesButton" Content="How to play" Style="{StaticResource SecondaryButton}" Click="RulesButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
