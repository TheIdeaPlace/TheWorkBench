<Window x:Class="TheCardPlace.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About The Card Place" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=InfoText}">
    <StackPanel Margin="20,16">
        <TextBlock Text="The Card Place" FontSize="22" FontWeight="Bold" />
        <TextBox x:Name="InfoText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" BorderThickness="0"
                 FontSize="14" Margin="0,8,0,0" AutomationProperties.Name="About" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_Copy version information" Click="Copy_Click" />
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="90" Margin="0,0,0,8" />
        </StackPanel>
    </StackPanel>
</Window>
