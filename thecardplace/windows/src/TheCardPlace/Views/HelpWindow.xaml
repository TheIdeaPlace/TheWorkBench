<Window x:Class="TheCardPlace.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="600" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Sections at the left, one Tab stop; the text of the chosen section at the right, in a
         read-only box the screen reader can read line by line. Escape closes. -->
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Label DockPanel.Dock="Top" Content="_Sections" Target="{Binding ElementName=SectionList}" Padding="0,0,0,2" FontSize="14" />
                <ListBox x:Name="SectionList" FontSize="15" AutomationProperties.Name="Sections"
                         KeyboardNavigation.TabNavigation="Once" SelectionChanged="SectionList_SelectionChanged" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <Label DockPanel.Dock="Top" x:Name="BodyLabel" Content="_Text" Target="{Binding ElementName=BodyText}" Padding="0,0,0,2" FontSize="14" />
                <TextBox x:Name="BodyText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" FontSize="15"
                         Padding="6" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Text" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
