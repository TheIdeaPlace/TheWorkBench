<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows high contrast: every colour is one the person chose. Cards are window-coloured
         with a window-text border; red suits are told apart by their symbol, which every card
         prints, never by colour alone. -->
    <SolidColorBrush x:Key="Brush.Felt" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.FeltTable" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Rail" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.OnFelt" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.OnFeltSoft" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Window" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextSoft" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.Dimmed" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.FocusEdge" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.CardFace" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.CardFaceOff" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.CardEdge" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.CardRed" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.CardBlack" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Chosen" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.ChosenText" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.Slot" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.Turn" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
