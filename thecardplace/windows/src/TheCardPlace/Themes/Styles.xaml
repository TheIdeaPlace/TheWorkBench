<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TheCardPlace.App.Views">

    <!-- A focus ring that shows on the felt and on white alike: amber with a dark edge, 3 pixels,
         instead of WPF's one-pixel dotted line. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-4">
                        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="5" Stroke="{DynamicResource Brush.FocusEdge}" />
                        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="3" Stroke="{DynamicResource Brush.Focus}" Margin="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,4,12,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- The button that moves the game on: Pass, Deal, Continue. Amber, bold, always first in the
         controls. Dimmed is a grey that still carries its label at 7:1; it stays a button that
         can be reached and pressed, and says why it is not ready. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusEdge}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2.5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="Tag" Value="dimmed">
                            <Setter Property="Background" Value="{DynamicResource Brush.Dimmed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DimmedText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="42" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="dimmed">
                <Setter Property="Opacity" Value="0.7" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A section label on the felt. A Label, so its access key moves to the control it names. -->
    <Style x:Key="FeltLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnFelt}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="2,0,0,2" />
    </Style>

    <Style x:Key="PanelLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0,8,0,2" />
    </Style>

    <!-- A list that is one Tab stop, arrows inside, no type-ahead (letters are the game's keys). -->
    <Style x:Key="QuietList" TargetType="ListBox">
        <Setter Property="IsTextSearchEnabled" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
    </Style>

    <!-- A card in the hand. The item is the control the screen reader is on; the face inside it is
         decoration. Focus is the amber ring; a card chosen for a pass rises and is marked with a tick
         and the word, so neither state depends on colour. -->
    <Style x:Key="HandItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- The FanPanel lays the cards out; the focused card comes to the front. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel x:Name="Root" Margin="0,16,0,0">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="10" Margin="-5" BorderThickness="0" />
                            <v:CardFace Card="{Binding Card}" IsOff="{Binding IsOff}" Badge="{Binding Badge}" />
                        </Grid>
                        <TextBlock x:Name="Mark" Text="✓ chosen" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"
                                   Margin="0,4,0,0" Padding="5,1" Visibility="Hidden"
                                   Foreground="{DynamicResource Brush.ChosenText}" Background="{DynamicResource Brush.Chosen}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Chosen}" Value="True">
                            <Setter TargetName="Root" Property="Margin" Value="0,0,0,16" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Panel.ZIndex" Value="100" />
                            <Setter TargetName="Ring" Property="BorderThickness" Value="4" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="50" />
                            <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.OnFeltSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A chair at the table: the card they have played to this trick, then their name and facts
         beside it. Compact, so five or six chairs fit round a small window. -->
    <Style x:Key="SeatItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Plate" CornerRadius="10" Padding="8,6" BorderThickness="2"
                            BorderBrush="Transparent" Background="{DynamicResource Brush.Rail}">
                        <StackPanel Orientation="Horizontal">
                            <v:CardFace Card="{Binding Played}">
                                <v:CardFace.LayoutTransform>
                                    <ScaleTransform ScaleX="0.78" ScaleY="0.78" />
                                </v:CardFace.LayoutTransform>
                            </v:CardFace>
                            <StackPanel VerticalAlignment="Center" Margin="8,0,2,0" Width="118">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.OnFelt}" />
                                <TextBlock Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.OnFeltSoft}" />
                                <TextBlock Text="{Binding PlayedNote}" FontSize="12.5" FontStyle="Italic" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.OnFelt}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsTurn}" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Brush.Turn}" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Plate" Property="BorderThickness" Value="4" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>
</ResourceDictionary>
