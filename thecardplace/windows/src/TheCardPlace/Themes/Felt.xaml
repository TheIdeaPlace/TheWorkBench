<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The designed look: the felt green of the app icon, white cards, amber for focus and for
         the button that moves the game on. Contrast, measured against the felt (#005D42):
         white text 7.9:1, amber focus ring 5.1:1. Against a card face (white): red ink #B0122A
         6.6:1, black ink #1A1A1A 17:1. When Windows is in a high contrast theme, App swaps this
         dictionary for HighContrast.xaml, which uses the system colours instead. -->
    <SolidColorBrush x:Key="Brush.Felt" Color="#005D42" />
    <RadialGradientBrush x:Key="Brush.FeltTable" GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#0A7352" Offset="0" />
        <GradientStop Color="#005D42" Offset="0.65" />
        <GradientStop Color="#004A35" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Brush.Rail" Color="#00402E" />
    <SolidColorBrush x:Key="Brush.OnFelt" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.OnFeltSoft" Color="#D8EDE4" />
    <SolidColorBrush x:Key="Brush.Window" Color="#F5F2EA" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#8A8A80" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.TextSoft" Color="#4A4A44" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFC83D" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Dimmed" Color="#A9B4AE" />
    <SolidColorBrush x:Key="Brush.DimmedText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#FFC83D" />
    <SolidColorBrush x:Key="Brush.FocusEdge" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.CardFace" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardFaceOff" Color="#CFCFCB" />
    <SolidColorBrush x:Key="Brush.CardEdge" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.CardRed" Color="#B0122A" />
    <SolidColorBrush x:Key="Brush.CardBlack" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Chosen" Color="#1F5FD1" />
    <SolidColorBrush x:Key="Brush.ChosenText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Slot" Color="#338A6C" />
    <SolidColorBrush x:Key="Brush.Turn" Color="#FFC83D" />
</ResourceDictionary>
