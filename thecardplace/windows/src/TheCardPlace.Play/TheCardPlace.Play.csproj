<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything about playing a game that is not drawing it: the sessions that drive the
       engines, the announcer, the pace, the settings. No WPF here, so whole games can be
       played in tests, and a different front end could reuse it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TheCardPlace.Play.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheCardPlace.Core\TheCardPlace.Core.csproj" />
    <ProjectReference Include="..\TheCardPlace.Hearts\TheCardPlace.Hearts.csproj" />
    <ProjectReference Include="..\TheCardPlace.Spades\TheCardPlace.Spades.csproj" />
    <ProjectReference Include="..\TheCardPlace.Euchre\TheCardPlace.Euchre.csproj" />
    <ProjectReference Include="..\TheCardPlace.Cribbage\TheCardPlace.Cribbage.csproj" />
    <ProjectReference Include="..\TheCardPlace.Sheephead\TheCardPlace.Sheephead.csproj" />
  </ItemGroup>
</Project>
